# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - CENTRO DE COMANDO EDTECH
# Copia este archivo como .env y completa tus credenciales reales.
# =====================================================================

# --- Conexión a Azure SQL Database ---
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Credenciales SMTP de Gmail (Notificaciones y Recuperación) ---
EMAIL_APP=
EMAIL_PASS=

# --- Opciones de Rendimiento y Réplica (Opcionales) ---
AZURE_REPLICA=true
MODO_ALTA_VELOCIDAD=true
GMAIL_WEBHOOK_URL=
